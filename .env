# Google Cloud API Keys for AI Detection
GOOGLE_CLOUD_API_KEY=AIzaSyDemoBuildYourOwnKeyFromGoogleCloud
GOOGLE_VISION_API_URL=https://vision.googleapis.com/v1/images:annotate

# Deepfake Detection APIs
DEEPFAKE_API_KEY=demo_key_replace_with_actual
DEEPFAKE_API_URL=https://api.deepfake-detection.com/analyze

# Audio Deepfake Detection (Google Cloud Speech)
GOOGLE_SPEECH_API_KEY=AIzaSyDemoBuildYourOwnKeyFromGoogleCloud
GOOGLE_SPEECH_API_URL=https://speech.googleapis.com/v1/speech:recognize

# Video Detection API
VIDEO_DETECTION_API_KEY=demo_key_replace_with_actual
VIDEO_DETECTION_API_URL=https://api.video-detection.com/analyze

# Local Server Config
PORT=3000
NODE_ENV=development

# Feature Flags
ENABLE_REAL_TIME_DETECTION=true
ENABLE_FAST_MODE=true
ENABLE_BATCH_PROCESSING=true

# Detection Confidence Thresholds
IMAGE_CONFIDENCE_THRESHOLD=0.75
VOICE_CONFIDENCE_THRESHOLD=0.80
VIDEO_CONFIDENCE_THRESHOLD=0.70

# Voice Assistant Config
VOICE_ASSISTANT_ENABLED=true
ENABLE_VOICE_PLAYBACK_FILTER=true
ENABLE_QUESTION_QUEUE=true
VOICE_RESPONSE_TIMEOUT=5000
